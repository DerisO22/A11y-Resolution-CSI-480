    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node src/index.ts",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
