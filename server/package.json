    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
